<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:pay_i="http://www.regione.veneto.it/schemas/2012/Pagamenti/Ente/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.regione.veneto.it/schemas/2012/Pagamenti/Ente/"
	elementFormDefault="qualified" attributeFormDefault="unqualified"
	version="1.0">
	<xsd:annotation>
		<xsd:documentation>Bilancio Default</xsd:documentation>
		<xsd:documentation>XSD Bilancio Default</xsd:documentation>
	</xsd:annotation>


	<!-- **** BEGIN: tipi semplici **** -->

  <xsd:simpleType name="stText64">
    <xsd:restriction base="xsd:string">
      <xsd:minLength value="1" />
      <xsd:maxLength value="64" />
    </xsd:restriction>
  </xsd:simpleType>

  	<xsd:complexType name="ctAccertamentoDefault">
	    <xsd:sequence>
	    	<xsd:element type="pay_i:stText64" name="codAccertamento" minOccurs="0" />
	    	<xsd:element type="xsd:string" name="importo" minOccurs="1" />
	    </xsd:sequence>
	  </xsd:complexType>
  	<xsd:complexType name="ctCapitoloDefault">
    	<xsd:sequence>
			<xsd:element name="codCapitolo" type="pay_i:stText64" minOccurs="1" />
			<xsd:element name="codUfficio" type="pay_i:stText64" minOccurs="0" />
			<xsd:element name="accertamento" type="pay_i:ctAccertamentoDefault" minOccurs="1" maxOccurs="unbounded" />
		</xsd:sequence>
  	</xsd:complexType>
  	<xsd:complexType name="ctBilancioDefault">
    	<xsd:sequence>
      	<xsd:element type="pay_i:ctCapitoloDefault" name="capitolo" maxOccurs="unbounded" minOccurs="1" />
    	</xsd:sequence>
  	</xsd:complexType>


	<!-- **** END: tipi complessi **** -->

	<!-- **** BEGIN: elementi **** -->
	<xsd:element name="bilancio" type="pay_i:ctBilancioDefault" />

	<!-- **** END: elementi **** -->
</xsd:schema>
